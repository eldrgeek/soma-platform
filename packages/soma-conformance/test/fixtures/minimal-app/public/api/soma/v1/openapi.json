            "description": "Missing or invalid authentication"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SomaErrorResponse"
                }
              }
            },
            "description": "Authenticated but unauthorized"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SomaErrorResponse"
                }
              }
            },
            "description": "State conflict"
          }
        },
        "security": [
          {
            "somaAgentBearer": []
          }
        ],
        "summary": "Execute coaching.save-reflection",
        "x-soma-action-id": "coaching.save-reflection",
        "x-soma-action-kind": "effect",
        "x-soma-action-version": "1",
        "x-soma-requires-idempotency-key": true,
        "x-soma-status": "not_live"
      }
    },
    "/api/soma/v1/actions/coaching.save-reflection/prepare": {
      "post": {
        "operationId": "prepare_coaching_save_reflection",
        "requestBody": {
          "content": {
            "application/json": {
