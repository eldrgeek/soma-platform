    "/api/soma/v1/status": {
      "get": {
        "operationId": "status",
        "responses": {
          "200": {
            "description": "Status snapshot"
          }
        },
        "security": [],
        "summary": "Release and dependency status",
        "x-soma-status": "not_live"
      }
    }
  },
  "servers": [
    {
      "url": "https://veric-coaching.netlify.app"
    }
  ]
}
