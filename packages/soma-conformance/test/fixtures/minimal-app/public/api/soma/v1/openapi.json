      }
    },
    "/api/soma/v1/ask": {
      "post": {
        "operationId": "ask",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "page_context": {
                    "maxLength": 4000,
                    "type": "string"
                  },
                  "question": {
                    "maxLength": 2000,
                    "type": "string"
                  },
                  "route": {
                    "type": "string"
                  }
                },
                "required": [
                  "question"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Grounded or degraded answer"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SomaErrorResponse"
                }
              }
            },
            "description": "Admission limit"
          }
        },
        "security": [],
        "summary": "Ask the app host from declared knowledge",
        "x-soma-status": "not_live"
