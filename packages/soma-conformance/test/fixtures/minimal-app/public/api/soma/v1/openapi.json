                  "$ref": "#/components/schemas/SomaErrorResponse"
                }
              }
            },
            "description": "Authenticated but unauthorized"
          }
        },
        "security": [
          {
            "somaAgentBearer": []
          }
        ],
        "summary": "Prepare coaching.save-reflection",
        "x-soma-action-id": "coaching.save-reflection",
        "x-soma-action-kind": "effect",
        "x-soma-action-version": "1",
        "x-soma-status": "not_live"
      }
    },
    "/api/soma/v1/approvals/{approval_id}": {
      "get": {
        "operationId": "getApproval",
        "parameters": [
          {
            "in": "path",
            "name": "approval_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Approval state"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SomaErrorResponse"
