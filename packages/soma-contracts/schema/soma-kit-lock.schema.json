{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soma-guide.netlify.app/schema/soma-kit-lock.schema.json",
  "title": "SOMA kit lock file",
  "type": "object",
  "required": [
    "kit_version",
    "source_commit",
    "template",
    "contract_sha256",
    "guide",
    "feedback_chip",
    "packages"
  ],
  "additionalProperties": false,
  "properties": {
    "kit_version": { "$ref": "#/$defs/version" },
    "source_commit": { "$ref": "#/$defs/commit" },
    "template": {
      "type": "object",
      "required": ["repository", "commit"],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            {
              "type": "string",
              "pattern": "^file:///[^\\s\\u0000-\\u001F\\u007F]+$"
            }
          ]
        },
        "commit": { "$ref": "#/$defs/commit" }
      }
    },
    "contract_sha256": { "$ref": "#/$defs/sha256" },
    "guide": {
      "type": "object",
      "required": ["version", "assets"],
      "additionalProperties": false,
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url", "integrity"],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[1-9][0-9]{0,4})?/[^\\s\\u0000-\\u001F\\u007F]+$"
              },
              "integrity": {
                "type": "string",
                "pattern": "^sha384-[A-Za-z0-9+/]{64}$"
              }
            }
          }
        }
      }
    },
    "feedback_chip": {
      "type": "object",
      "required": ["widget_files"],
      "additionalProperties": false,
      "properties": {
        "widget_files": {
          "type": "object",
          "required": [
            "public/vendor/soma-feedback/soma-feedback.js",
            "public/vendor/soma-feedback/soma-feedback.css"
          ],
          "additionalProperties": false,
          "properties": {
            "public/vendor/soma-feedback/soma-feedback.js": { "$ref": "#/$defs/sha256" },
            "public/vendor/soma-feedback/soma-feedback.css": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "packages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^@soma/[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["version", "sha256"],
        "additionalProperties": false,
        "properties": {
          "version": { "$ref": "#/$defs/version" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
