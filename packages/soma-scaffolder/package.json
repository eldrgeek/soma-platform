{
  "name": "@soma/scaffolder",
  "version": "0.0.1",
  "description": "Scaffold a Soma app from an app spec: validate the spec, then emit the per-app files the enabled affordances need from templates/soma-affordances.",
  "type": "module",
  "bin": {
    "soma-scaffold": "bin/soma-scaffold.mjs"
  },
  "exports": {
    ".": "./src/scaffold.mjs",
    "./spec": "./src/spec.mjs"
  },
  "scripts": {
    "validate": "node bin/soma-scaffold.mjs validate examples/legends.soma.json",
    "scaffold": "node bin/soma-scaffold.mjs scaffold examples/legends.soma.json",
    "build-knowledge": "node tools/build-guide-knowledge.mjs",
    "standup-check": "node tools/standup-check.mjs",
    "test": "node --test test/*.test.mjs",
    "mutation-check-v1-guards": "node scripts/mutation-check-v1-guards.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@soma/conformance": "file:../soma-conformance",
    "@soma/contracts": "file:../soma-contracts",
    "@soma/discovery": "file:../soma-discovery"
  }
}
